{
  "name": "saas-mini",
  "private": true,
  "workspaces": [
    "packages/*",
    "products/*"
  ],
  "scripts": {
    "dev": "npm run dev -w peluqueria",
    "build": "npm run build -w @saas-mini/core && npm run build -w peluqueria && npm run build -w deportes && npm run build -w talleres && npm run build -w inventario && npm run build -w cotizaciones && npm run build -w documentos && npm run build -w recordatorios",
    "seed": "npm run seed -w peluqueria",
    "seed:deportes": "npm run seed -w deportes",
    "dev:deportes": "npm run dev -w deportes",
    "seed:talleres": "npm run seed -w talleres",
    "dev:talleres": "npm run dev -w talleres",
    "seed:inventario": "npm run seed -w inventario",
    "dev:inventario": "npm run dev -w inventario",
    "seed:cotizaciones": "npm run seed -w cotizaciones",
    "dev:cotizaciones": "npm run dev -w cotizaciones",
    "seed:documentos": "npm run seed -w documentos",
    "dev:documentos": "npm run dev -w documentos",
    "seed:recordatorios": "npm run seed -w recordatorios",
    "dev:recordatorios": "npm run dev -w recordatorios",
    "test": "npm run test -w @saas-mini/core",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}