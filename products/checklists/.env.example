# Checklists e Inspecciones sobre el runtime de AMG.
# Copie este archivo a `.env` y ajuste los valores.

NODE_ENV=development
PORT=3026

# Esta base es SOLO de checklists. La identidad no esta aca: vive en core.sqlite.
DB_PATH=./data/checklists.sqlite
# Suba este numero cuando agregue una migracion nueva en src/.
DB_SCHEMA_VERSION=2

# El Core: identidad, organizaciones y suscripciones.
CORE_URL=http://localhost:3108
APP_URL=http://localhost:3026

# Con Docker hay que hablarle por el nombre del servicio, no por localhost.
CORE_PORT=3108

# Credenciales SSO que entrega el Core: `npm run sso:secret -w @amg/platform -- checklists`
AMG_SSO_CLIENT_ID=checklists
AMG_SSO_CLIENT_SECRET=

# Pongalo en 1 si quiere que una baja de suscripcion corte el acceso al instante.
# Sin esto el token vive hasta 15 minutos.
AMG_SSO_INTROSPECT=0
