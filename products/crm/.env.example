# Copia este archivo a `.env`
NODE_ENV=development
PORT=3007

# Ruta del archivo SQLite (se crea automáticamente)
DB_PATH=./data/app.db

# IMPORTANTE: cambia esta por una clave larga y aleatoria en producción
JWT_SECRET=cambia-esta-clave-en-produccion-por-favor

# El CRM usa SMTP solo para envíos de recordatorios ligados a citas (opcional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

APP_NAME=Gestión de Clientes
APP_URL=http://localhost:3007