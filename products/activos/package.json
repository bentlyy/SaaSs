{
  "name": "@amg/activos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Activos sobre el runtime de AMG: equipos y bienes con su historial de movimientos. Sin usuarios ni contrasenas propias.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amg/auth-client": "*",
    "@amg/product-runtime": "*"
  },
  "devDependencies": {
    "@amg/platform": "*",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
