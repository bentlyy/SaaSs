# Gestion de Clientes sobre el runtime de AMG.
# Copie este archivo a `.env` y ajuste los valores.

NODE_ENV=development
PORT=3020

# Esta base es SOLO de clientes. La identidad no esta aca: vive en core.sqlite.
DB_PATH=./data/clientes.sqlite
# Suba este numero cuando agregue una migracion nueva en src/.
DB_SCHEMA_VERSION=1

# El Core: identidad, organizaciones y suscripciones.
CORE_URL=http://localhost:3108
APP_URL=http://localhost:3023

# La migracion de datos legacy (npm run migrate:legacy) necesita ademas
# saber donde esta el core.sqlite del Core, y lee la config de @amg/platform.
#
# CUIDADO con esta variable: el Core la resuelve RELATIVA al directorio de
# trabajo, y `npm run -w` cambia ese directorio. Si no la fije, la migracion
# puede abrir un core.sqlite NUEVO junto a este producto, crear ahi la
# organizacion y dejar los datos en un lado y la identidad en el otro.
# Fijela siempre, apuntando al mismo archivo que usa el Core.
#   - local (Core corriendo desde la raiz): ../../data/core/core.sqlite
#   - docker: el Core vive en el volumen saasmini_data_core
CORE_DB_PATH=../../data/core/core.sqlite
# Con Docker hay que hablarle por el nombre del servicio, no por localhost.
CORE_PORT=3108

# Credenciales SSO que entrega el Core: `npm run sso:secret -w @amg/platform -- clientes`
AMG_SSO_CLIENT_ID=clientes
AMG_SSO_CLIENT_SECRET=

# Pongalo en 1 si quiere que una baja de suscripcion corte el acceso al instante.
# Sin esto el token vive hasta 15 minutos.
AMG_SSO_INTROSPECT=0
