# Citas sobre el runtime de AMG.
# Copiá este archivo a `.env` y ajustá los valores.

NODE_ENV=development
PORT=3021

# Esta base es SOLO de citas. La identidad no está acá: vive en core.sqlite.
DB_PATH=./data/citas.sqlite
# Subí este número cuando agregues una migración nueva en src/.
DB_SCHEMA_VERSION=1

# El Core: identidad, organizaciones y suscripciones.
CORE_URL=http://localhost:3108
APP_URL=http://localhost:3021

# La migración de datos legacy (npm run migrate:legacy) necesita además
# saber dónde está el core.sqlite del Core, y lee la config de @amg/platform.
#
# CUIDADO con esta variable: el Core la resuelve RELATIVA al directorio de
# trabajo, y `npm run -w` cambia ese directorio. Si no la fijás, la migración
# puede abrir un core.sqlite NUEVO junto a este producto, crear ahí la
# organización y dejar los datos en un lado y la identidad en el otro.
# Fijala siempre, apuntando al mismo archivo que usa el Core.
#   - local (Core corriendo desde la raíz): ../../data/core/core.sqlite
#   - docker: el Core vive en el volumen saasmini_data_core
CORE_DB_PATH=../../data/core/core.sqlite
# Con Docker hay que hablarle por el nombre del servicio, no por localhost.
CORE_PORT=3108

# Credenciales SSO que entrega el Core: `npm run sso:secret -w @amg/platform -- citas`
AMG_SSO_CLIENT_ID=citas
AMG_SSO_CLIENT_SECRET=

# Ponelo en 1 si querés que una baja de suscripción corte el acceso al instante.
# Sin esto el token vive hasta 15 minutos.
AMG_SSO_INTROSPECT=0
