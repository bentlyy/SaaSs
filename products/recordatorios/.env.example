# Copia este archivo a `.env`
NODE_ENV=development
PORT=3006

# Ruta del archivo SQLite (se crea automáticamente)
DB_PATH=./data/app.db

# IMPORTANTE: cambia esta por una clave larga y aleatoria en producción
JWT_SECRET=cambia-esta-clave-en-produccion-por-favor

# Canal de email (SMTP). Deja vacío para desactivar recordatorios por correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@saas-mini.local

# WhatsApp se configura por negocio desde la app (Configuración): URL de webhook
# + token de una pasarela (Twilio, 360dialog, WATI, plataforma propia).
# El webhook recibe `{ to, text }` con header `Authorization: Bearer <token>`.

APP_NAME=Alertas Pro
APP_URL=http://localhost:3006