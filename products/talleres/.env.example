# Copia este archivo a `.env`
NODE_ENV=development
PORT=3002

# Ruta del archivo SQLite (se crea automáticamente)
DB_PATH=./data/app.db

# IMPORTANTE: cambia esto por una clave larga y aleatoria en producción
JWT_SECRET=cambia-esta-clave-en-produccion-por-favor

# Opcional: recordatorios por email (SMTP). Sin esto solo se registran en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@saas-mini.local

APP_NAME=Talleres
APP_URL=http://localhost:3002