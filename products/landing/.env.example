# ─────────────────────────────────────────────────────────────────────────────
# products/landing → el Core de la plataforma (@amg/platform)
#
# Este servicio NO es un mini-SaaS más: es el Core. Guarda usuarios,
# organizaciones, membresías, sesiones, catálogo, suscripciones y pagos en
# core.sqlite, y sirve la web (landing, catálogo, acceso, mi cuenta).
#
# Los productos (espacios, citas, inventario...) siguen con su propio .env y su
# propia base: no leen nada de acá salvo por SSO. Ver docs/ARCHITECTURE.md.
#
# ── Dónde va la configuración ───────────────────────────────────────────────
# ESTE archivo ya no se copia: en desarrollo la configuración del Core vive en
# el `.env` de la RAÍZ del monorepo, y no hace falta crear nada acá.
#
# La razón es concreta. `npm run -w` cambia el directorio de trabajo, y dotenv
# lee el `.env` de ese directorio. Con un `.env` del Core dentro de este
# workspace, el mismo proceso abierto desde `products/landing` y desde
# `packages/platform` leía archivos distintos: cada uno abría su propio
# core.sqlite, con clientes SSO diferentes, y el único síntoma era un login que
# fallaba sin decir por qué. `config.ts` lee el `.env` del cwd primero y el de
# la raíz después, sin sobrescribir, así que un `.env` acá sigue sirviendo como
# override — pero no debería hacer falta.
#
# Lo que sigue es la REFERENCIA de las variables del Core, no un archivo para
# copiar. En producción los valores los fija docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Puerto del Core. En docker-compose el Core escucha 3000 DENTRO del contenedor y
# lo publica en 3108, que es el número que espera el resto del stack. En local,
# 3108 también: es el que ponen los .env de los productos en CORE_URL.
CORE_PORT=3108

# Ruta de la base CENTRAL. Distinta a propósito de la de cada producto: si
# apunta al mismo archivo que un producto, se pierde el aislamiento.
# Relativa al directorio de trabajo, que en `npm run -w` es este workspace: así
# `../../data/core/core.sqlite` es la base de la raíz del monorepo, la misma que
# leen los productos y la que monta el compose.
CORE_DB_PATH=../../data/core/core.sqlite

# URL pública del Core. Es la que va en los enlaces de SSO y en los correos de
# recuperación de contraseña. En producción TIENE que ser la real
# (https://desarrollo.amgdeveloper.cl): con localhost, los correos de
# recuperación devuelven al usuario a la página equivocada.
CORE_URL=http://localhost:3108

APP_NAME=AMG

# ── Secretos ─────────────────────────────────────────────────────────────────
# Los DOS son obligatorios en producción: si faltan, el proceso no arranca
# (fail-fast, sin valores por defecto conocidos). En desarrollo, si no los pones,
# se generan al azar por proceso — reiniciar cierra todas las sesiones, que es
# lo que se quiere al desarrollar.
#
# Genéralos con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# AMG_SESSION_SECRET: firma los tokens de sesión y de los códigos SSO.
# AMG_SSO_ROOT_SECRET: raíz de derivación (HKDF) de la que sale el secreto de
#   CADA producto. Cambiarlo invalida todos los clientes SSO a la vez.
AMG_SESSION_SECRET=
AMG_SSO_ROOT_SECRET=

# ── Sesión y SSO ─────────────────────────────────────────────────────────────
# Vida de la cookie de sesión, en días.
CORE_SESSION_DAYS=30
# Nombre de la cookie. Host-only: nunca con Domain.
CORE_SESSION_COOKIE=amg_session
# Vida del código de autorización SSO (segundos) y del token que recibe el
# producto (segundos). Cortos a propósito.
CORE_SSO_CODE_TTL=60
CORE_SSO_TOKEN_TTL=900
# Ventana de los enlaces de recuperación y de verificación de correo (minutos).
CORE_PASSWORD_RESET_TTL_MIN=60
CORE_EMAIL_VERIFY_TTL_MIN=1440

# Dominios permitidos como retorno tras el login. Separados por coma, sin
# https://. Es la lista que impide redirecciones abiertas.
CORE_RETURN_URL_HOSTS=amgdeveloper.cl,localhost

# ── Callbacks SSO de desarrollo ──────────────────────────────────────────────
# En producción el único callback válido de cada producto es el de su subdominio
# y sale del catálogo. En local los productos corren en `http://localhost:<puerto>`,
# que no está en ninguna lista: sin esto el Core responde "La dirección de retorno
# no está autorizada" y no se puede entrar a ningún producto desde la máquina de
# desarrollo. En producción la lista se ignora aunque se declare.
CORE_SSO_LOCAL_CALLBACKS=http://localhost:3022/auth/callback

# ── Correo (opcional) ────────────────────────────────────────────────────────
# Sin SMTP los correos se registran en el log: sirve para desarrollo, NO para
# producción (el usuario nunca recibe el enlace de recuperación).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@amgdeveloper.cl
CONTACT_EMAIL=hola@amgdeveloper.cl

# ── Diagnóstico ──────────────────────────────────────────────────────────────
# Clave para leer /api/_diagnostico en producción. Vacía = endpoint inexistente.
CORE_DIAGNOSTICO_KEY=
