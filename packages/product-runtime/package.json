{
  "name": "@amg/product-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base de cada aplicacion AMG: abre SU propia SQLite, monta la identidad del Core y garantiza que ningun endpoint se escape de organization_id. No tiene usuarios ni contrasenas.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "echo \"@amg/product-runtime es una libreria: no se ejecuta\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amg/auth-client": "*",
    "@saas-mini/core": "0.1.0",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
